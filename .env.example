# Which AI platform to use:
# openai | openrouter | groq | mistral | gemini | huggingface | cloudflare | ollama
AI_PROVIDER=ollama

# API key from that platform (Ollama accepts any placeholder, or leave unset)
AI_API_KEY=ollama

# Model name (must already be pulled in Ollama: `ollama pull llama3.2`)
AI_MODEL=llama3.2

# Optional: override the API base URL (default for ollama is http://127.0.0.1:11434/v1)
# AI_BASE_URL=http://127.0.0.1:11434/v1

# Required only when AI_PROVIDER=cloudflare
# CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id

# Legacy (still supported if AI_API_KEY is unset):
# OPENAI_API_KEY=sk-...
