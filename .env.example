# Which AI platform to use:
# openai | openrouter | groq | mistral | gemini | huggingface | cloudflare
AI_PROVIDER=openai

# API key from that platform
AI_API_KEY=your-api-key-here

# Optional: override the default model for the provider
# AI_MODEL=gpt-4o-mini

# Optional: override the API base URL (OpenAI-compatible providers)
# AI_BASE_URL=https://api.openai.com/v1

# Required only when AI_PROVIDER=cloudflare
# CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id

# Legacy (still supported if AI_API_KEY is unset):
# OPENAI_API_KEY=sk-...
